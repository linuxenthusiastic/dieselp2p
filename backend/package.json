{
  "name": "dieselp2p-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DieselP2P API - motor de matching, costos, anomalías e impacto (MVP demo)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:sql": "tsx src/data/generateSeedSql.ts",
    "test:flow": "tsx src/scripts/demoFlow.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
