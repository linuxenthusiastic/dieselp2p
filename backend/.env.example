# Backend Node.js / Express
PORT=4000

# Supabase (service role SOLO en backend, nunca en el frontend).
# Si se dejan vacías, la API usa un store en memoria con los datos seed (demo inmediata).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modo demo: habilita POST /api/auth/demo-login (perfiles ficticios sin contraseña)
DEMO_MODE=true
# Fuerza el store en memoria aunque exista Supabase
FORCE_MEMORY_STORE=false

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Acepta orígenes de la red local (para abrir la demo desde un celular con "vite --host").
# Ponlo en false en producción.
ALLOW_LAN_ORIGINS=true

# Parámetros FICTICIOS del motor de costos
COST_PER_KM=28
BASE_TRIP_COST=400
REFERENCE_PRICE_PER_LITER=21
TRUCK_CAPACITY_LITERS=10000
MAX_RADIUS_KM=350
MAX_SUPPLIERS_PER_MATCH=4
