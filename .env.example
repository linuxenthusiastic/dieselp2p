# DieselP2P — variables de entorno de referencia.
# Copia los bloques a backend/.env y frontend/.env. NUNCA subas secretos reales.

# ───────── backend/.env ─────────
PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MODE=true
FORCE_MEMORY_STORE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COST_PER_KM=12
BASE_TRIP_COST=150
REFERENCE_PRICE_PER_LITER=4.15
TRUCK_CAPACITY_LITERS=10000
MAX_RADIUS_KM=350
MAX_SUPPLIERS_PER_MATCH=4

# ───────── frontend/.env ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
